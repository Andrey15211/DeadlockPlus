# DeadlockForge — шаблон переменных окружения.
# Скопируйте в .env и заполните; .env в репозиторий не попадает.

# Ключ LLM (DeepSeek / OpenAI / Gemini / Anthropic / роутер).
# Приоритет выше БД и api.txt. Если задать пустым — файлы ключа игнорируются.
DEADLOCKFORGE_AI_KEY=

# Bearer-токен deadlock-api: повышает лимиты запросов (иначе 3/час).
DEADLOCK_API_KEY=

# Каталоги данных и SPA. Пусто = значения по умолчанию (data/, web/).
# В frozen-сборке выставляются автоматически в run_desktop.py.
DEADLOCK_DATA_DIR=
DEADLOCK_WEB_DIR=

# 1 — открыть DevTools в окне PyWebView (отладка UI).
DEADLOCK_DEBUG=

# Путь к pak01_dir.vpk для извлечения ассетов из локальной установки игры.
# DEADLOCK_VPK=C:\SteamLibrary\steamapps\common\Deadlock\game\citadel\pak01_dir.vpk